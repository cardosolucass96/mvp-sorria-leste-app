{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorria-leste-mcp",
  "account_id": "d603948925acaef083c8eafe1a05c2c4",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SDR_DEFAULT_UNIT_ID": "3",
    "SDR_CREATED_BY_USER_ID": "58"
  },
  "secrets": {
    "required": ["MCP_ALLOWED_EMAILS", "MCP_WRITE_ALLOWED_EMAILS", "SDR_API_KEY", "BI_API_KEY"]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "6aa5c70fed4a4535873dcc91490c1d92" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sorria-leste-db",
      "database_id": "1a32c7e9-c5e7-4c53-89f0-3169d2ba7e4f"
    }
  ],
  "env": {
    "staging": {
      "name": "sorria-leste-mcp-staging",
      "preview_urls": false,
      "vars": {
        "SDR_DEFAULT_UNIT_ID": "3",
        "SDR_CREATED_BY_USER_ID": "1"
      },
      "secrets": {
        "required": ["MCP_ALLOWED_EMAILS", "MCP_WRITE_ALLOWED_EMAILS", "SDR_API_KEY", "BI_API_KEY"]
      },
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "508f8a32f1bf4ef9b2f179ce0c47e687" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sorria-leste-db-staging",
          "database_id": "8d2eb56d-9527-4292-b63f-3edb5650548c"
        }
      ]
    }
  }
}
