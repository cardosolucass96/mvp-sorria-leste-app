{
  "name": "mvp-sorria-leste-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:components": "jest --config jest.components.config.js",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "extract:simplifica": "node scripts/extract-simplifica.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:create": "wrangler d1 create sorria-leste-db",
    "d1:migrate": "wrangler d1 execute sorria-leste-db --remote --file=lib/schema.sql",
    "d1:migrate:local": "wrangler d1 execute sorria-leste-db --local --file=lib/schema.sql",
    "d1:migrate:pagamentos-legado": "wrangler d1 execute sorria-leste-db --remote --file=lib/migrations/backfill_pagamentos_legado.sql",
    "d1:migrate:pagamentos-legado:local": "wrangler d1 execute sorria-leste-db --local --file=lib/migrations/backfill_pagamentos_legado.sql",
    "d1:seed": "wrangler d1 execute sorria-leste-db --remote --file=lib/seed.sql",
    "d1:seed:formas-pagamento": "wrangler d1 execute sorria-leste-db --remote --file=lib/migrations/seed_formas_pagamento_todas_unidades.sql",
    "d1:seed:formas-pagamento:local": "wrangler d1 execute sorria-leste-db --local --file=lib/migrations/seed_formas_pagamento_todas_unidades.sql",
    "d1:seed:local": "wrangler d1 execute sorria-leste-db --local --file=lib/seed.sql",
    "d1:pull-prod": "bash scripts/pull-prod-db.sh",
    "d1:timestamps:audit:local": "node scripts/d1-timestamps-utc.mjs audit --local",
    "d1:timestamps:audit:remote": "node scripts/d1-timestamps-utc.mjs audit --remote",
    "d1:timestamps:normalize:local": "node scripts/d1-timestamps-utc.mjs apply --local",
    "d1:timestamps:normalize:remote": "node scripts/d1-timestamps-utc.mjs apply --remote",
    "d1:timestamps:bulk-sql:local": "node scripts/d1-timestamps-utc.mjs bulk-sql --local",
    "d1:timestamps:bulk-sql:remote": "node scripts/d1-timestamps-utc.mjs bulk-sql --remote",
    "d1:timestamps:normalize:local:bulk": "node scripts/d1-timestamps-utc.mjs bulk-apply --local",
    "d1:timestamps:normalize:remote:bulk": "node scripts/d1-timestamps-utc.mjs bulk-apply --remote",
    "d1:backup:local": "node scripts/d1-timestamps-utc.mjs backup --local",
    "d1:backup:remote": "node scripts/d1-timestamps-utc.mjs backup --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.15.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wrangler": "^4.60.0"
  }
}
